            }
            else
            {
                richTextBox1.AppendText(DateTime.Now.ToString("HH:mm:ss") + "：加载参数设置成功......\r\n");
                richTextBox1.Refresh();
            }
            #endregion 从配置文件中加载参数设置

            #region
            if (GlobalVariable.configSetting.duanMianACameraPhotoSetting.photoNumber <= 0)
            {
                GlobalVariable.configSetting.duanMianACameraPhotoSetting.photoNumber = GlobalVariable.iDuanMianAPictureNumber;
            }
            if (GlobalVariable.configSetting.duanMianACameraPhotoSetting.photoSpan <= 0)
            {
