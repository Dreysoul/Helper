        private void loadErrorCodeStatistic()
        {
            string msg = "";
            JsonHelper.ReadJsonFile(FilePath.duanMianAStatisticPath, ref GlobalVariable.duanMianAErrCodeStatistic, ref msg);
            JsonHelper.ReadJsonFile(FilePath.waiYuanAStatisticPath, ref GlobalVariable.waiYuanAErrCodeStatistic, ref msg);
            JsonHelper.ReadJsonFile(FilePath.daoJiaoAStatisticPath, ref GlobalVariable.daoJiaoAErrCodeStatistic, ref msg);
            JsonHelper.ReadJsonFile(FilePath.neiKongStatisticPath, ref GlobalVariable.neiKongErrCodeStatistic, ref msg);
            JsonHelper.ReadJsonFile(FilePath.duanMianBStatisticPath, ref GlobalVariable.duanMianBErrCodeStatistic, ref msg);
            JsonHelper.ReadJsonFile(FilePath.waiYuanBStatisticPath, ref GlobalVariable.waiYuanBErrCodeStatistic, ref msg);
            JsonHelper.ReadJsonFile(FilePath.daoJiaoBStatisticPath, ref GlobalVariable.daoJiaoBErrCodeStatistic, ref msg);

            if (GlobalVariable.duanMianAErrCodeStatistic == null)
            {
                GlobalVariable.duanMianAErrCodeStatistic = new Dictionary<string, int>();
            }
            if (GlobalVariable.waiYuanAErrCodeStatistic == null)
            {
                GlobalVariable.waiYuanAErrCodeStatistic = new Dictionary<string, int>();
            }
            if (GlobalVariable.daoJiaoAErrCodeStatistic == null)
            {
                GlobalVariable.daoJiaoAErrCodeStatistic = new Dictionary<string, int>();
            }
            if (GlobalVariable.neiKongErrCodeStatistic == null)
            {
                GlobalVariable.neiKongErrCodeStatistic = new Dictionary<string, int>();
            }
            if (GlobalVariable.duanMianBErrCodeStatistic == null)
            {
                GlobalVariable.duanMianBErrCodeStatistic = new Dictionary<string, int>();
            }
            if (GlobalVariable.waiYuanBErrCodeStatistic == null)
            {
                GlobalVariable.waiYuanBErrCodeStatistic = new Dictionary<string, int>();
            }
            if (GlobalVariable.daoJiaoBErrCodeStatistic == null)
            {
                GlobalVariable.daoJiaoBErrCodeStatistic = new Dictionary<string, int>();
            }
        }

        public void initMultiImgDetect()
        {
            if (GlobalVariable.configSetting.daoJiaoAParam.rect != null && GlobalVariable.configSetting.daoJiaoAParam.rect.Count() != BearingInspection.Global.multiImgDetectNum)
            {
                detectRect[] rects = new detectRect[GlobalVariable.configSetting.daoJiaoAParam.rect.Count()];
                for (int i = 0; i < rects.Count(); i++)
                {
                    rects[i] = GlobalVariable.configSetting.daoJiaoAParam.rect[i];
                }
                GlobalVariable.configSetting.daoJiaoAParam.rect = new detectRect[BearingInspection.Global.multiImgDetectNum];
                for (int i = 0; i < rects.Count(); i++)
                {
                    GlobalVariable.configSetting.daoJiaoAParam.rect[i] = rects[i];
                }
            }
            if (GlobalVariable.configSetting.neiKongParam.rect != null && GlobalVariable.configSetting.neiKongParam.rect.Count() != BearingInspection.Global.multiImgDetectNum)
            {
                detectRect[] rects = new detectRect[GlobalVariable.configSetting.neiKongParam.rect.Count()];
                for (int i = 0; i < rects.Count(); i++)
                {
                    rects[i] = GlobalVariable.configSetting.neiKongParam.rect[i];
                }
                GlobalVariable.configSetting.neiKongParam.rect = new detectRect[BearingInspection.Global.multiImgDetectNum];
                for (int i = 0; i < rects.Count(); i++)
                {
                    GlobalVariable.configSetting.neiKongParam.rect[i] = rects[i];
                }
            }
            if (GlobalVariable.configSetting.waiYuanBParam.rect != null && GlobalVariable.configSetting.waiYuanBParam.rect.Count() != BearingInspection.Global.multiImgDetectNum)
            {
                detectRect[] rects = new detectRect[GlobalVariable.configSetting.waiYuanBParam.rect.Count()];
                for (int i = 0; i < rects.Count(); i++)
                {
                    rects[i] = GlobalVariable.configSetting.waiYuanBParam.rect[i];
                }
                GlobalVariable.configSetting.waiYuanBParam.rect = new detectRect[BearingInspection.Global.multiImgDetectNum];
                for (int i = 0; i < rects.Count(); i++)
                {
                    GlobalVariable.configSetting.waiYuanBParam.rect[i] = rects[i];
                }
            }
            if (GlobalVariable.configSetting.daoJiaoBParam.rect != null && GlobalVariable.configSetting.daoJiaoBParam.rect.Count() != BearingInspection.Global.multiImgDetectNum)
            {
                detectRect[] rects = new detectRect[GlobalVariable.configSetting.daoJiaoBParam.rect.Count()];
                for (int i = 0; i < rects.Count(); i++)
                {
                    rects[i] = GlobalVariable.configSetting.daoJiaoBParam.rect[i];
                }
                GlobalVariable.configSetting.daoJiaoBParam.rect = new detectRect[BearingInspection.Global.multiImgDetectNum];
                for (int i = 0; i < rects.Count(); i++)
                {
                    GlobalVariable.configSetting.daoJiaoBParam.rect[i] = rects[i];
                }
            }
            if (GlobalVariable.configSetting.daoJiaoAFlag.blobEnable != null && GlobalVariable.configSetting.daoJiaoAFlag.blobEnable.Count() != BearingInspection.Global.multiImgDetectNum)
            {
                bool[] blobEnables = new bool[GlobalVariable.configSetting.daoJiaoAFlag.blobEnable.Count()];
                for (int i = 0; i < blobEnables.Count(); i++)
                {
                    blobEnables[i] = GlobalVariable.configSetting.daoJiaoAFlag.blobEnable[i];
                }
                GlobalVariable.configSetting.daoJiaoAFlag.blobEnable = new bool[BearingInspection.Global.multiImgDetectNum];
                for (int i = 0; i < blobEnables.Count(); i++)
                {
                    GlobalVariable.configSetting.daoJiaoAFlag.blobEnable[i] = blobEnables[i];
                }
            }
            if (GlobalVariable.configSetting.neiKongFlag.blobEnable != null && GlobalVariable.configSetting.neiKongFlag.blobEnable.Count() != BearingInspection.Global.multiImgDetectNum)
            {
                bool[] blobEnables = new bool[GlobalVariable.configSetting.neiKongFlag.blobEnable.Count()];
                for (int i = 0; i < blobEnables.Count(); i++)
                {
                    blobEnables[i] = GlobalVariable.configSetting.neiKongFlag.blobEnable[i];
                }
                GlobalVariable.configSetting.neiKongFlag.blobEnable = new bool[BearingInspection.Global.multiImgDetectNum];
                for (int i = 0; i < blobEnables.Count(); i++)
                {
                    GlobalVariable.configSetting.neiKongFlag.blobEnable[i] = blobEnables[i];
                }
            }
            if (GlobalVariable.configSetting.waiYuanBFlag.blobEnable != null && GlobalVariable.configSetting.waiYuanBFlag.blobEnable.Count() != BearingInspection.Global.multiImgDetectNum)
            {
                bool[] blobEnables = new bool[GlobalVariable.configSetting.waiYuanBFlag.blobEnable.Count()];
                for (int i = 0; i < blobEnables.Count(); i++)
                {
                    blobEnables[i] = GlobalVariable.configSetting.waiYuanBFlag.blobEnable[i];
                }
                GlobalVariable.configSetting.waiYuanBFlag.blobEnable = new bool[BearingInspection.Global.multiImgDetectNum];
                for (int i = 0; i < blobEnables.Count(); i++)
                {
                    GlobalVariable.configSetting.waiYuanBFlag.blobEnable[i] = blobEnables[i];
                }
            }
            if (GlobalVariable.configSetting.daoJiaoBFlag.blobEnable != null && GlobalVariable.configSetting.daoJiaoBFlag.blobEnable.Count() != BearingInspection.Global.multiImgDetectNum)
            {
                bool[] blobEnables = new bool[GlobalVariable.configSetting.daoJiaoBFlag.blobEnable.Count()];
                for (int i = 0; i < blobEnables.Count(); i++)
                {
                    blobEnables[i] = GlobalVariable.configSetting.daoJiaoBFlag.blobEnable[i];
                }
                GlobalVariable.configSetting.daoJiaoBFlag.blobEnable = new bool[BearingInspection.Global.multiImgDetectNum];
                for (int i = 0; i < blobEnables.Count(); i++)
                {
                    GlobalVariable.configSetting.daoJiaoBFlag.blobEnable[i] = blobEnables[i];
                }
            }

            if (GlobalVariable.configSetting.daoJiaoAParam.rect == null)
            {
                GlobalVariable.configSetting.daoJiaoAParam.rect = new detectRect[BearingInspection.Global.multiImgDetectNum];
            }
            if (GlobalVariable.configSetting.neiKongParam.rect == null)
            {
                GlobalVariable.configSetting.neiKongParam.rect = new detectRect[BearingInspection.Global.multiImgDetectNum];
            }
            if (GlobalVariable.configSetting.waiYuanBParam.rect == null)
            {
                GlobalVariable.configSetting.waiYuanBParam.rect = new detectRect[BearingInspection.Global.multiImgDetectNum];
            }
            if (GlobalVariable.configSetting.daoJiaoBParam.rect == null)
            {
                GlobalVariable.configSetting.daoJiaoBParam.rect = new detectRect[BearingInspection.Global.multiImgDetectNum];
            }

            if (GlobalVariable.configSetting.daoJiaoAFlag.blobEnable == null)
            {
                GlobalVariable.configSetting.daoJiaoAFlag.blobEnable = new bool[BearingInspection.Global.multiImgDetectNum];
            }
            if (GlobalVariable.configSetting.neiKongFlag.blobEnable == null)
            {
                GlobalVariable.configSetting.neiKongFlag.blobEnable = new bool[BearingInspection.Global.multiImgDetectNum];
            }
            if (GlobalVariable.configSetting.waiYuanBFlag.blobEnable == null)
            {
                GlobalVariable.configSetting.waiYuanBFlag.blobEnable = new bool[BearingInspection.Global.multiImgDetectNum];
            }
            if (GlobalVariable.configSetting.daoJiaoBFlag.blobEnable == null)
            {
                GlobalVariable.configSetting.daoJiaoBFlag.blobEnable = new bool[BearingInspection.Global.multiImgDetectNum];
            }
        }

        public void Load111()
        {
            bool bWrong = false;
            string ErrorMsg = "";
            int plcErrorCode = 0;
            string TotalErrorMsg = "错误信息为：\r\n";

            loadErrorCodeStatistic();

            #region 注册码校验
            bool bRtn = true;// RegistrationCodeFunction.Check();
            //if (!bRtn)
            //{
            //    RegistrationCodeForm f = new RegistrationCodeForm();
            //    if (f.ShowDialog() != DialogResult.OK)
            //    {
            //        Environment.Exit(0);
            //    }
            //}
            //else
            //{
            //    richTextBox1.AppendText(DateTime.Now.ToString("HH:mm:ss") + "：注册码校验成功......\r\n");
            //    richTextBox1.Refresh();
            //}
            #endregion 注册码校验

            #region 全局参数第一次实例化
            bRtn = GlobalVariable.Init();
            if (!bRtn)
            {
                UIHelper.RichTestBoxAppendTextColorful(richTextBox1, DateTime.Now.ToString("HH:mm:ss") + "：实例化全局参数失败......\r\n", Color.Red);
                MessageBox.Show("实例化全局参数错误");
                bWrong = true;
            }
            else
            {
                richTextBox1.AppendText(DateTime.Now.ToString("HH:mm:ss") + "：实例化全局参数成功......\r\n");
                richTextBox1.Refresh();
            }
            #endregion 全局参数第一次实例化

            #region 从配置文件中加载厂商设置
            bRtn = JsonHelper.ReadJsonFile(FilePath.VendorSettingPath, ref GlobalVariable.machineSetting, ref ErrorMsg);
            if (!bRtn)
            {
                UIHelper.RichTestBoxAppendTextColorful(richTextBox1, DateTime.Now.ToString("HH:mm:ss") + "：加载厂商设置失败......\r\n", Color.Red);
                MessageBox.Show("加载厂商设置错误");
                bWrong = true;
            }
            else
            {
                richTextBox1.AppendText(DateTime.Now.ToString("HH:mm:ss") + "：加载厂商设置成功......\r\n");
                richTextBox1.Refresh();
            }
            #endregion 从配置文件中加载厂商设置

            #region 从配置文件中加载通用设置
            bRtn = JsonHelper.ReadJsonFile(FilePath.GeneralSettingPath, ref GlobalVariable.generalSetting, ref ErrorMsg);
            if (!bRtn)
            {
                UIHelper.RichTestBoxAppendTextColorful(richTextBox1, DateTime.Now.ToString("HH:mm:ss") + "：加载通用设置失败......\r\n", Color.Red);
                MessageBox.Show("加载通用设置错误");
                bWrong = true;
            }
            else
            {
                richTextBox1.AppendText(DateTime.Now.ToString("HH:mm:ss") + "：加载通用设置成功......\r\n");
                richTextBox1.Refresh();
            }
            #endregion 从配置文件中加载通用设置

            #region 从配置文件中加载硬件设置
            bRtn = JsonHelper.ReadJsonFile(FilePath.HardwareSettingPath, ref GlobalVariable.hardwareSetting, ref ErrorMsg);
            if (!bRtn)
            {
                UIHelper.RichTestBoxAppendTextColorful(richTextBox1, DateTime.Now.ToString("HH:mm:ss") + "：加载硬件设置失败......\r\n", Color.Red);
                MessageBox.Show("加载硬件设置错误");
                bWrong = true;
            }
            else
            {
                richTextBox1.AppendText(DateTime.Now.ToString("HH:mm:ss") + "：加载硬件设置成功......\r\n");
                richTextBox1.Refresh();
            }
            #endregion 从配置文件中加载硬件设置

            #region 从配置文件中加载参数设置
            bRtn = JsonHelper.ReadJsonFile(FilePath.ParamSettingPath + GlobalVariable.configname + "\\Param.Json", ref GlobalVariable.configSetting, ref ErrorMsg);
            if (!bRtn)
            {
                UIHelper.RichTestBoxAppendTextColorful(richTextBox1, DateTime.Now.ToString("HH:mm:ss") + "：加载参数设置失败......\r\n", Color.Red);
                MessageBox.Show("加载参数设置错误");
