            ckbFlag29.Checked = true;
            checkBox1.Checked = true;
            checkBox2.Checked = true;
            #endregion
            string errorMsg = "";
            bool bRtn = SaveParam(ref errorMsg);
            if (bRtn)
            {
                MessageBox.Show("打开所有算子成功");
